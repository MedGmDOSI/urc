# Neon (PostgreSQL) + Upstash KV : récupérées via `vercel env pull .env.development.local`
POSTGRES_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (images) : créer un store Blob et le connecter au projet
BLOB_READ_WRITE_TOKEN=

# Pusher Beams (notifications push)
PUSHER_INSTANCE_ID=
PUSHER_SECRET_KEY=
# Même valeur que PUSHER_INSTANCE_ID, exposée au front par Vite
VITE_PUSHER_INSTANCE_ID=
